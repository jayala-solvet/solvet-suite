APP_NAME="Solvet Gestión"
APP_VERSION=0.1.0
APP_ENV=local
APP_DEBUG=false
APP_KEY=
APP_URL=http://localhost:8088
APP_PORT=8088
BIND_ADDRESS=127.0.0.1
COMPOSE_PROJECT_NAME=solvet-suite
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES
LOG_CHANNEL=stack
LOG_LEVEL=warning
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=solvet
DB_USERNAME=solvet
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
MAIL_MAILER=log

# Passwords: Argon2id accepts existing bcrypt hashes and upgrades on login.
HASH_DRIVER=argon2id
SECURITY_SESSION_MAX_MINUTES=480
SECURITY_MFA_ENABLED=true
# Comma-separated exact proxy IPs/CIDRs and hostnames; never *.
TRUSTED_PROXIES=
TRUSTED_HOSTS=
# Configure a real provider before invitations/recovery; never commit credentials.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Solvet-IT"

# Public age recipient only; keep its private identity outside the server.
BACKUP_AGE_RECIPIENT=
