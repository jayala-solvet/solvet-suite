# Template only. Replace hosts/certificates and verify the actual proxy chain.
# Never deploy unmodified. Upstream must be loopback/private and firewall-restricted.
# At http context (outside server):
limit_req_zone $binary_remote_addr zone=solvet_requests:10m rate=20r/s;
server {
    listen 443 ssl;
    server_name REEMPLAZAR_DOMINIO;
    ssl_certificate /REEMPLAZAR/fullchain.pem;
    ssl_certificate_key /REEMPLAZAR/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 10m;
    # No query string, Referer or tokens in access logs. Configure a matching
    # private log_format at http level as in docker/nginx.conf.
    access_log /var/log/nginx/solvet-access.log solvet_private;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    location / {
        limit_req zone=solvet_requests burst=60 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8091;
        proxy_set_header Host REEMPLAZAR_DOMINIO;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        # Do not forward attacker-provided chains as trusted IP information.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header Forwarded "";
        proxy_read_timeout 60s;
        proxy_no_cache 1;
        proxy_cache_bypass 1;
    }
}
